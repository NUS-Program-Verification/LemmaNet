{
  "llm": {
    "model": "openai/gpt-5.2-2025-12-11",
    "temperature": 0.0,
    "max_tokens": 2000,
    "timeout": 30,
    "api_key": null,
    "api_base": null,
    "enable_caching": true
  },
  "coq": {
    "timeout": 60,
    "max_steps": 100,
    "workspace": null,
    "library_paths": [
      {
        "path": "/LemmaNet/benchmarks/AutoRocq-bench/libautorocq",
        "name": "libframac"
      }
    ],
    "auto_setup_coqproject": true,
    "coqproject_extra_options": []
  },
  "interactive": {
    "enabled": false
  },
  "ablation": {
    "enable_recording": true,
    "enable_error_feedback": true,
    "enable_hammer": false,
    "enable_history_context": true,
    "enable_rollback": true,
    "enable_context_search": true,
    "enable_helper_lemma": true,
    "max_context_search": 3,
    "max_errors": 3
  },
  "log_level": "INFO",
  "output_dir": null
}
